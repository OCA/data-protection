<odoo>
    <record id="privacy_partner_report_wizard" model="ir.ui.view">
        <field name="name">Partner Report</field>
        <field name="model">privacy.partner.report</field>
        <field name="arch" type="xml">
            <form string="Report Options">
                <header>
                    <button
                        name="button_export_xlsx"
                        string="Export XLSX"
                        type="object"
                        default_focus="1"
                        class="oe_highlight"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field
                                string="Select a company"
                                name="company_id"
                                options="{'no_create': True}"
                            />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field
                                string="Select a partner"
                                name="partner_id"
                                options="{'no_create': True}"
                                domain="[('company_id', 'in', [False, company_id]),'|', ('active', '=', False), ('active', '=', True)]"
                            />
                        </group>
                    </group>
                    <group
                        string='Models with related partner data'
                        invisible="not partner_id"
                        col="1"
                    >
                        <field
                            name="table_ids"
                            options="{'no_create': True}"
                            editable="bottom"
                            nolabel="1"
                        >
                            <list>
                                <field name="model_id" />
                                <field name="count_rows" text-align="right" />
                                <button
                                    name="action_view_records"
                                    type="object"
                                    icon="fa-info-circle"
                                    title="View Records"
                                    invisible="count_rows == 0"
                                />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_privacy_partner_menu" model="ir.actions.act_window">
        <field name="name">Partner Report</field>
        <field name="res_model">privacy.partner.report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="privacy_partner_report_wizard" />
        <field name="target">current</field>
    </record>
</odoo>
